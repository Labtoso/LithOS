#!/bin/bash
# Startet den LithOS-Installer (Calamares) mit der LithOS-Konfiguration
sudo cp -rf /etc/lithos/calamares/modules/. /etc/calamares/modules/
sudo cp -f /etc/lithos/calamares/settings.conf /etc/calamares/settings.conf
exec sudo --preserve-env=WAYLAND_DISPLAY,XDG_RUNTIME_DIR,XDG_SESSION_TYPE,QT_QPA_PLATFORM,DISPLAY,XAUTHORITY,LANG,LANGUAGE,XDG_CURRENT_DESKTOP,KDE_FULL_SESSION,KDE_SESSION_VERSION,QT_QPA_PLATFORMTHEME,XDG_SESSION_DESKTOP \
  calamares "$@"
