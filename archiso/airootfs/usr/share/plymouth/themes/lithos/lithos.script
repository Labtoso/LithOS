Window.SetBackgroundTopColor(0.051, 0.067, 0.090);
Window.SetBackgroundBottomColor(0.051, 0.067, 0.090);
cx = Window.GetX() + Window.GetWidth() / 2;
cy = Window.GetY() + Window.GetHeight() / 2;

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(cx - logo.image.GetWidth() / 2, cy - logo.image.GetHeight() / 2 - 40, 1);

dot_on = Image("dot.png");
dot_off = Image("dot-dim.png");
for (i = 0; i < 3; i++) {
  dots[i] = Sprite(dot_off);
  dots[i].SetPosition(cx - 25 + i * 20, cy + logo.image.GetHeight() / 2 + 10, 1);
}
frame = 0;
fun refresh_cb() {
  frame++;
  active = Math.Int(frame / 12) % 3;
  for (i = 0; i < 3; i++) {
    if (i == active) dots[i].SetImage(dot_on); else dots[i].SetImage(dot_off);
  }
}
Plymouth.SetRefreshFunction(refresh_cb);

# Passwortabfrage (verschlüsselte Festplatte)
entry.image = Image("entry.png");
bullet.image = Image("bullet.png");
fun display_normal_cb() {
  entry.sprite.SetOpacity(0); prompt.sprite.SetOpacity(0);
  for (i = 0; bullets[i]; i++) bullets[i].SetOpacity(0);
  for (i = 0; i < 3; i++) dots[i].SetOpacity(1);
}
fun display_password_cb(prompt_text, count) {
  for (i = 0; i < 3; i++) dots[i].SetOpacity(0);
  ey = cy + logo.image.GetHeight() / 2 + 30;
  entry.sprite = Sprite(entry.image);
  entry.sprite.SetPosition(cx - entry.image.GetWidth() / 2, ey, 2);
  prompt.image = Image.Text("Passwort für die Festplatte", 0.9, 0.93, 0.95);
  prompt.sprite = Sprite(prompt.image);
  prompt.sprite.SetPosition(cx - prompt.image.GetWidth() / 2, ey - 28, 2);
  for (i = 0; bullets[i]; i++) bullets[i].SetOpacity(0);
  for (i = 0; i < count && i < 30; i++) {
    bullets[i] = Sprite(bullet.image);
    bullets[i].SetPosition(cx - entry.image.GetWidth() / 2 + 16 + i * 10, ey + 14, 3);
  }
}
Plymouth.SetDisplayNormalFunction(display_normal_cb);
Plymouth.SetDisplayPasswordFunction(display_password_cb);

fun message_cb(text) {
  msg.image = Image.Text(text, 0.6, 0.65, 0.7);
  msg.sprite = Sprite(msg.image);
  msg.sprite.SetPosition(cx - msg.image.GetWidth() / 2, Window.GetY() + Window.GetHeight() - 60, 2);
}
Plymouth.SetMessageFunction(message_cb);
